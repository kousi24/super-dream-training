class Solution {
    public long interchangeableRectangles(int[][] rectangles) {
        HashMap<String, Long> map = new HashMap<>();
        long ans = 0;

        for (int[] r : rectangles) {
            int g = gcd(r[0], r[1]);
            String key = (r[0] / g) + "/" + (r[1] / g);

            ans += map.getOrDefault(key, 0L);
            map.put(key, map.getOrDefault(key, 0L) + 1);
        }

        return ans;
    }

    int gcd(int a, int b) {
        while (b != 0) {
            int t = a % b;
            a = b;
            b = t;
        }
        return a;
    }
}

