class Solution {
    public boolean containsDuplicate(int[] nums) {
        for (int i = 0; i < nums.length; i++) {
            for (int j = i + 1; j < nums.length; j++) {
                if (nums[i] == nums[j])
                    return true;
            }
        }
        return false;
    }
}
class Solution {
    public void moveZeroes(int[] nums) {
        int pos = 0;

        for (int x : nums) {
            if (x != 0)
                nums[pos++] = x;
        }

        while (pos < nums.length)
            nums[pos++] = 0;
    }
}
