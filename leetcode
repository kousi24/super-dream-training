class Solution {
    public String reversePrefix(String word, char ch) {
        int index = word.indexOf(ch);

        if (index == -1)
            return word;

        StringBuilder ans = new StringBuilder(word.substring(0, index + 1));
        ans.reverse();

        return ans + word.substring(index + 1);
    }
}


