class Solution {
    public int[] smallestMissingValueSubtree(int[] parents, int[] nums) {
        int n = nums.length;
        int[] ans = new int[n];
        Arrays.fill(ans, 1);

        int node = -1;
        for (int i = 0; i < n; i++)
            if (nums[i] == 1) node = i;

        if (node == -1) return ans;

        ArrayList<Integer>[] tree = new ArrayList[n];
        for (int i = 0; i < n; i++) tree[i] = new ArrayList<>();

        for (int i = 1; i < n; i++)
            tree[parents[i]].add(i);

        boolean[] seen = new boolean[n + 2];
        int missing = 1;

        while (node != -1) {
            mark(node, tree, nums, seen);
            
            while (missing < seen.length && seen[missing])
                missing++;

            ans[node] = missing;
            node = parents[node];
        }

        return ans;
    }

    void mark(int node, ArrayList<Integer>[] tree, int[] nums, boolean[] seen) {
        if (seen[nums[node]]) return;

        seen[nums[node]] = true;

        for (int child : tree[node])
            mark(child, tree, nums, seen);
    }
}

