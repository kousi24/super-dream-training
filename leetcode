class Solution {
    public void moveZeroes(int[] nums) {
        int pos = 0;

        for (int x : nums) {
            if (x != 0)
                nums[pos++] = x;
        }

        while (pos < nums.length)
            nums[pos++] = 0;
    }
}

class Solution {
    public void duplicateZeros(int[] arr) {
        int[] temp = arr.clone();

        int j = 0;

        for (int x : temp) {
            if (j >= arr.length) break;

            arr[j++] = x;

            if (x == 0 && j < arr.length)
                arr[j++] = 0;
        }
    }
}


class Solution {
    public int[] replaceElements(int[] arr) {
        int max = -1;

        for (int i = arr.length - 1; i >= 0; i--) {
            int temp = arr[i];
            arr[i] = max;
            max = Math.max(max, temp);
        }

        return arr;
    }
}


